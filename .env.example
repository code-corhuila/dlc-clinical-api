# Every variable read by dlc-clinical-api. Placeholders only; never commit real values.
HTTP_ADDR=:8080
APP_ENV=dev

# Explicit server limits (Norma 5.3.10). Zero is rejected because it means unlimited.
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=20s

# Identity boundary: the service validates RS256 tokens with the identity service's
# public key. Set exactly one key source; never a private or shared key.
JWT_ISSUER=<identity-issuer>
JWT_AUDIENCE=clinical-service
# qa and main require the Auth JWKS (keys rotate by kid); one PEM key is accepted in
# dev only. Tokens must carry iat, jti, sid, roles and permissions (authentication.md).
# JWT_JWKS_URL=http://auth-service:8080/api/v1/auth/jwks
# JWKS_MIN_REFRESH=30s
# Token permissions that give an Administrator clinical read/write access (PAT-003).
# Pending the Auth permission catalogue: align these with the names Auth issues.
CLINICAL_READ_PERMISSION=clinical:read
CLINICAL_WRITE_PERMISSION=clinical:write
JWT_PUBLIC_KEY_FILE=<path-to-public-key.pem>
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Clinical MongoDB (schema owned by dlc-clinical-db, instance by dlc-infra-mongo).
# Never connect as the engine administrator. Explicit limits.
# Runtime identity clinical_runtime from dlc-infra-mongo (roles clinical_application, clinical_outbox_publisher,
# clinical_inbox_consumer and clinical_analytics_projector). Its password is the secret
# dlc/<stage>/clinical-mongo/runtime-password, read from MONGO_PASSWORD_FILE: never put it in MONGO_URI.
# authSource defaults to MONGO_DATABASE. In qa and main add TLS with the stage CA (Go driver reads tlsCAFile):
#   MONGO_URI=mongodb://dlc-mongo:27017/?replicaSet=rs0&tls=true&tlsCAFile=/run/secrets/clinical/mongo-tls-ca.pem
MONGO_URI=mongodb://dlc-mongo:27017/?replicaSet=rs0
MONGO_PASSWORD_FILE=/run/secrets/clinical/clinical-runtime-password
# MONGO_USERNAME=clinical_runtime
CLINICAL_DATA_NETWORK_NAME=clinical-data
MONGO_DATABASE=clinical
MONGO_MAX_POOL_SIZE=10
MONGO_TIMEOUT=5s

# Integration tests only: a database migrated by dlc-clinical-db (tests skip when unset).
# TEST_MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true

# Outbox relay (cmd/clinical-outbox-relay). Explicit bounds (Norma 5.3.10, Anexo D).
# The MongoDB user of the relay needs the clinical_outbox_publisher role.
RABBITMQ_URL=amqp://<user>:<password>@<broker-host>:5672/
RELAY_EXCHANGE=clinical.events
RELAY_PUBLISH_TIMEOUT=5s
RELAY_BATCH_SIZE=100
RELAY_INTERVAL=5s
RELAY_RUN_TIMEOUT=30s
# 20 attempts with full-jitter backoff capped at RELAY_MAX_DELAY ride out a broker
# outage of about half an hour before an event is marked FAILED.
RELAY_MAX_ATTEMPTS=20
RELAY_BASE_DELAY=1s
RELAY_MAX_DELAY=5m

# Integration tests only (skip when unset).
# TEST_RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# Inbox consumer (cmd/clinical-inbox-consumer): owner quorum queue with a DLQ.
# Its MongoDB user needs clinical_inbox_consumer and clinical_application.
INBOX_QUEUE=clinical.closure-outcomes
INBOX_DELIVERY_LIMIT=10
INBOX_PREFETCH=10
INBOX_HANDLER_TIMEOUT=10s
INBOX_REDELIVERY_DELAY=2s

# Private owner contracts (internal-coordination.yaml). Leave a URL empty and that
# owner keeps failing closed (503). Service credentials are never versioned.
# In qa and main every URL is required, and each owner has its own credential file
# (short-lived service JWT with that owner's audience, authentication.md). The file
# is read on every call, so it can be rotated in place without a restart.
# auth-service: session revocation check.
AUTH_INTERNAL_URL=
PATIENTS_INTERNAL_URL=
APPOINTMENTS_INTERNAL_URL=
BILLING_INTERNAL_URL=
# AUTH_SERVICE_TOKEN_FILE=/run/secrets/clinical-to-auth
# PATIENTS_SERVICE_TOKEN_FILE=/run/secrets/clinical-to-patients
# APPOINTMENTS_SERVICE_TOKEN_FILE=/run/secrets/clinical-to-appointments
# BILLING_SERVICE_TOKEN_FILE=/run/secrets/clinical-to-billing
# dev only: one shared credential for every owner without its own file.
SERVICE_TOKEN_FILE=<path-to-service-token>
# SERVICE_TOKEN=
INTERNAL_TIMEOUT=3s

# Intent reconciler (ADR-017): needs APPOINTMENTS_INTERNAL_URL, BILLING_INTERNAL_URL and the service token above.
RECONCILE_INTERVAL=30s
RECONCILE_RUN_TIMEOUT=30s
RECONCILE_MIN_AGE=2m
RECONCILE_BATCH_SIZE=50

# HU-CLN-003 analytics consumer (own queue) and the clinic timezone used for days and months.
ANALYTICS_QUEUE=clinical.analytics
CLINIC_TIMEZONE=America/Bogota
