# Every variable read by dlc-clinical-api. Placeholders only; never commit real values.
HTTP_ADDR=:8080
APP_ENV=dev

# Explicit server limits (Norma 5.3.10). Zero is rejected because it means unlimited.
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=20s

# Identity boundary: the service validates RS256 tokens with the identity service's
# public key. Set exactly one key source; never a private or shared key.
JWT_ISSUER=<identity-issuer>
JWT_AUDIENCE=clinical-service
JWT_PUBLIC_KEY_FILE=<path-to-public-key.pem>
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Clinical MongoDB (schema owned by dlc-clinical-db, instance by dlc-infra-mongo).
# Connect as the clinical_app user, never as the administrator. Explicit limits.
MONGO_URI=mongodb://clinical_app:<password>@<mongo-host>:27017/clinical?replicaSet=rs0
MONGO_DATABASE=clinical
MONGO_MAX_POOL_SIZE=10
MONGO_TIMEOUT=5s

# Integration tests only: a database migrated by dlc-clinical-db (tests skip when unset).
# TEST_MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
