# Runtime
HTTP_ADDR=:8080
APP_ENV=local
SHUTDOWN_TIMEOUT=20s

# Clinical MongoDB is provisioned by dlc-clinical-db. The API never migrates it.
MONGO_URI=mongodb://mongo:27017/clinical?replicaSet=rs0
MONGO_DATABASE=clinical
MONGO_CONNECT_TIMEOUT=5s
MONGO_MAX_POOL_SIZE=10

# Identity boundary. Use exactly one source in a deployed environment.
JWT_ISSUER=CHANGE_ME
JWT_AUDIENCE=CHANGE_ME
JWT_PUBLIC_KEY_FILE=CHANGE_ME
# JWT_PUBLIC_KEY=CHANGE_ME
